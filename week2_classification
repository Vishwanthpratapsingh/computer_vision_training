        "id": "KVyelzN_pW2i"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "IMG = 224\n",
        "MEAN, STD = (0.485, 0.456, 0.406), (0.229, 0.224, 0.225)\n",
        "\n",
        "plain_tf = A.Compose([A.Resize(IMG, IMG), A.Normalize(mean=MEAN, std=STD), ToTensorV2()])\n",
        "aug_tf = A.Compose([\n",
        "    A.Resize(IMG, IMG),\n",
        "    A.HorizontalFlip(p=0.5),\n",
        "    A.Affine(scale=(0.85, 1.15), translate_percent=(-0.1, 0.1), rotate=(-15, 15), p=0.7),\n",
        "    A.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.3, hue=0.05, p=0.7),\n",
        "    A.Normalize(mean=MEAN, std=STD),\n",
        "    ToTensorV2(),\n",
        "])\n",
        "\n",
        "class AlbDataset(Dataset):\n",
        "    def __init__(self, base, indices, tf):\n",
        "        self.base, self.indices, self.tf = base, indices, tf\n",
        "    def __len__(self):\n",
        "        return len(self.indices)\n",
        "    def __getitem__(self, i):\n",
        "        img, label = self.base[self.indices[i]]\n",
        "        img = np.array(img.convert(\"RGB\"))\n",
        "        return self.tf(image=img)[\"image\"], label\n",
        "\n",
        "def make_loaders(aug, batch_size=64):\n",
        "    ds = {k: AlbDataset(b, idx, aug_tf if (aug and k == \"train\") else plain_tf) for k, (b, idx) in splits.items()}\n",
