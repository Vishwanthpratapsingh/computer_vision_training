        "## 6. Training and evaluation code\n",
        "\n",
        "The same hand-written loop as Week 1: forward, loss, backward, step. The model with the best **validation** accuracy is kept, and the test set is used once at the end."
      ],
      "metadata": {
        "id": "5NEmEd8KppnN"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "results = {}\n",
        "\n",
        "def run_epoch(model, loader, kind, opt=None, collect=False):\n",
        "    training = opt is not None\n",
        "    if training: set_train(model, kind)\n",
        "    else: model.eval()\n",
        "    total_loss, correct, n = 0.0, 0, 0\n",
        "    all_preds, all_labels = [], []\n",
        "    with torch.set_grad_enabled(training):\n",
        "        for x, y in loader:\n",
        "            x, y = x.to(dev), y.to(dev)\n",
        "            logits = model(x)                  # forward\n",
        "            loss = F.cross_entropy(logits, y)  # loss\n",
        "            if training:\n",
        "                opt.zero_grad()\n",
        "                loss.backward()                # backward\n",
        "                opt.step()                     # step\n",
        "            total_loss += loss.item() * len(y)\n",
        "            pred = logits.argmax(1)\n",
        "            correct += (pred == y).sum().item()\n",
        "            n += len(y)\n",
        "            if collect:\n",
        "                all_preds.append(pred.cpu()); all_labels.append(y.cpu())\n",
        "    preds = torch.cat(all_preds).numpy() if collect else None\n",
        "    labels = torch.cat(all_labels).numpy() if collect else None\n",
        "    return total_loss / n, correct / n, preds, labels\n",
        "\n",
        "def fit(name, kind, aug, epochs, lr_head=1e-3, lr_backbone=1e-4):\n",
        "    set_seed()\n",
        "    loaders = make_loaders(aug)\n",
        "    model = make_model(kind, n_classes).to(dev)\n",
        "    opt = make_opt(model, kind, lr_head, lr_backbone)\n",
        "    hist = {\"train_loss\": [], \"val_loss\": [], \"train_acc\": [], \"val_acc\": []}\n",
        "    best_val, best_state = -1.0, None\n",
        "    t0 = time.time()\n",
        "    for ep in range(1, epochs + 1):\n",
        "        tl, ta, _, _ = run_epoch(model, loaders[\"train\"], kind, opt)\n",
        "        vl, va, _, _ = run_epoch(model, loaders[\"val\"], kind)\n",
        "        for k, v in zip(hist, (tl, vl, ta, va)): hist[k].append(v)\n",
        "        if va > best_val:\n",
        "            best_val, best_state = va, copy.deepcopy(model.state_dict())\n",
        "        print(f\"{name} | epoch {ep:02d} | train loss {tl:.3f} acc {ta:.3f} | val loss {vl:.3f} acc {va:.3f}\")\n",
        "    model.load_state_dict(best_state)\n",
        "    _, test_acc, preds, labels = run_epoch(model, loaders[\"test\"], kind, collect=True)\n",
        "    secs = time.time() - t0\n",
        "    print(f\"{name} | best val acc {best_val:.3f} | TEST ACC {test_acc:.3f} | {secs/60:.1f} min\")\n",
        "    results[name] = dict(kind=kind, aug=aug, epochs=epochs, lr_head=lr_head, lr_backbone=lr_backbone,\n",
        "                         best_val=best_val, test_acc=test_acc, hist=hist, preds=preds, labels=labels)\n",
        "\n",
        "def plot_run(name):\n",
        "    h = results[name][\"hist\"]\n",
        "    fig, ax = plt.subplots(1, 2, figsize=(10, 3.5))\n",
        "    ax[0].plot(h[\"train_loss\"], label=\"train\"); ax[0].plot(h[\"val_loss\"], label=\"val\"); ax[0].set_title(f\"{name}: loss\"); ax[0].legend()\n",
        "    ax[1].plot(h[\"train_acc\"], label=\"train\"); ax[1].plot(h[\"val_acc\"], label=\"val\"); ax[1].set_title(f\"{name}: accuracy\"); ax[1].legend()\n",
        "    for a in ax: a.set_xlabel(\"epoch\")\n",
        "    fig.tight_layout(); plt.show()"
      ],
